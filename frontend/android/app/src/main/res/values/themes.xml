<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 앱 실행 직후 스플래시 (Android 12+). 아이콘은 @mipmap/ic_launcher 와 동일 에셋 -->
    <style name="Theme.AImong.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.AImong</item>
    </style>

    <style name="Theme.AImong" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/aimong_primary</item>
        <item name="colorPrimaryVariant">@color/aimong_primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/aimong_secondary</item>
        <item name="colorSecondaryVariant">@color/aimong_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Edge-to-edge: 실제 색은 Window/인셋으로 처리 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:textViewStyle">@style/Widget.AImong.TextView</item>
        <item name="materialButtonStyle">@style/Widget.AImong.MaterialButton</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.AImong.MaterialButton.Outlined</item>
    </style>

    <style name="TransparentDialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="AimongBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AimongBottomSheetStyle</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>
    <style name="AimongBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
</resources>
