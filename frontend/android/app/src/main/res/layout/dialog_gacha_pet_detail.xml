<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_gacha_pet_detail_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_gacha_pet_detail_sprite_stage"
        android:padding="10dp">

        <ImageView
            android:id="@+id/iv_pet_sprite"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_pet_emoji"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="56sp"
            tools:text="⭐" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_pet_grade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_gacha_equipped_badge"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/quiz_mint_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="등급 · 레어" />

    <TextView
        android:id="@+id/tv_pet_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/quiz_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="반짝이" />

    <TextView
        android:id="@+id/tv_pet_growth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/quiz_text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="몽 · 12/80 XP"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/layout_fragment_exchange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_gacha_pet_detail_fragment_panel"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_fragment_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gacha_fragment_exchange_label"
            android:textColor="@color/quiz_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pb_fragments"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressDrawable="@drawable/bg_gacha_fragment_progress"
            tools:progress="70" />

        <TextView
            android:id="@+id/tv_fragment_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:textColor="@color/quiz_mint_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="7 / 10" />

        <TextView
            android:id="@+id/tv_exchange_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/gacha_exchange_manual_hint"
            android:textColor="@color/quiz_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_exchange"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="48dp"
        android:text="@string/gacha_exchange_button"
        android:textColor="@color/quiz_mint_dark"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:cornerRadius="14dp"
        app:strokeColor="@color/quiz_mint"
        app:strokeWidth="1.5dp"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_equip"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_gacha_pull_enabled"
        android:text="@string/gacha_equip_action"
        android:textColor="@color/quiz_on_accent"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:cornerRadius="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="40dp"
        android:text="@string/gacha_close"
        android:textColor="@color/quiz_text_grey"
        android:textSize="14sp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
