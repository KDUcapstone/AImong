<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_child_quest_sheet"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="22dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_chat_privacy_icon_circle">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_sparkles"
            app:tint="@color/child_nav_item_selected" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_onboarding_welcome_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/child_onboarding_welcome_title"
        android:textColor="@color/child_quest_sheet_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_onboarding_welcome_invite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/child_onboarding_welcome_invite"
        android:textColor="@color/child_quest_sheet_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_onboarding_welcome_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/child_quest_sheet_text_secondary"
        android:textSize="14sp"
        tools:text="스타터 티켓 3장이 준비됐어요.\n아이몽의 세계로 들어온 걸 환영해!" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_onboarding_welcome_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/child_nav_item_selected"
        android:text="@string/child_onboarding_welcome_start"
        android:textColor="@color/white"
        app:cornerRadius="14dp" />
</LinearLayout>
