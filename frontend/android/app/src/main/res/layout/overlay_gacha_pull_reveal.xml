<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_reveal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6101828"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tv_reveal_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="새로운 친구를 만났어요!" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_reveal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_reveal_title"
        app:strokeColor="@color/child_nav_item_selected"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <FrameLayout
                android:id="@+id/fl_reveal_pet"
                android:layout_width="@dimen/pet_sprite_gacha_reveal"
                android:layout_height="@dimen/pet_sprite_gacha_reveal"
                android:background="@drawable/bg_chat_pet_avatar">

                <ImageView
                    android:id="@+id/iv_reveal_sprite"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_reveal_emoji"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="80sp"
                    tools:text="🐧" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_reveal_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/quiz_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="방울펭귄" />

            <TextView
                android:id="@+id/tv_reveal_grade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/quiz_text_secondary"
                android:textSize="14sp"
                tools:text="등급 · 레어" />

            <TextView
                android:id="@+id/tv_reveal_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_gacha_reveal_badge"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:textColor="@color/child_nav_item_selected"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="신규 획득!" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_reveal_detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:textColor="#E6FFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_reveal"
        tools:text="조각 +3 · 남은 티켓 2장" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_reveal_confirm"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="32dp"
        android:text="@string/gacha_pull_reveal_confirm"
        android:textStyle="bold"
        app:backgroundTint="@color/child_nav_item_selected"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
