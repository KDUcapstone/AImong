<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/parent_mock_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/parent_mock_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_parent_mock_code_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp">

            <FrameLayout
                android:id="@+id/frame_confirm_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_stat_icon_blue"
                tools:background="@drawable/bg_stat_icon_red">

                <ImageView
                    android:id="@+id/iv_confirm_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_warning_triangle"
                    app:tint="@color/parent_mock_blue"
                    tools:tint="@color/parent_mock_logout" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_confirm_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@color/parent_mock_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="코드 재발급" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/parent_mock_border" />

        <TextView
            android:id="@+id/tv_confirm_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/parent_mock_text_secondary"
            android:textSize="14sp"
            tools:text="코드를 재발급하면 기존 자녀 기기의 로그인이 만료됩니다. 계속할까요?" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/parent_mock_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_cancel"
                style="@style/Widget.AImong.MaterialButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/parent_dialog_cancel"
                android:textColor="@color/parent_mock_text_secondary"
                app:cornerRadius="12dp"
                app:strokeColor="@color/parent_mock_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_action"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/parent_mock_blue"
                android:text="@string/auth_confirm"
                android:textColor="@color/parent_mock_surface"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                tools:text="재발급" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
