<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/iv_reward_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_child_quest_icon_circle"
        android:contentDescription="@null"
        android:padding="8dp"
        app:tint="@color/child_nav_item_selected"
        tools:src="@drawable/ic_chip_ticket" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_reward_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00FFB2"
            android:lineSpacingExtra="2dp"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="×3" />

        <TextView
            android:id="@+id/tv_reward_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/child_quest_sheet_text_secondary"
            android:textSize="13sp"
            tools:text="뽑기 티켓" />
    </LinearLayout>
</LinearLayout>
