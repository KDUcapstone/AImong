<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="#F9FAFB"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_stage_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/parent_mock_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="1단계" />

        <TextView
            android:id="@+id/tv_stage_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/parent_mock_text_muted"
            android:textSize="13sp"
            tools:text="3/5" />

        <TextView
            android:id="@+id/btn_stage_reward_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:text="@string/parent_stage_reward_edit"
            android:textColor="@color/parent_mock_indigo"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_stage_mission"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:max="5"
        android:minHeight="8dp"
        android:progressBackgroundTint="@color/parent_mock_border"
        android:progressTint="@color/parent_mock_blue"
        tools:progress="3" />

    <TextView
        android:id="@+id/tv_stage_reward_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/parent_mock_text_secondary"
        android:textSize="13sp"
        tools:text="약속: 놀이공원 가자!" />

    <TextView
        android:id="@+id/tv_stage_default_rewards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/parent_mock_text_muted"
        android:textSize="12sp"
        tools:text="기본 보상: 기어 30 · 일반 티켓 0" />

    <TextView
        android:id="@+id/tv_stage_triggered"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/parent_stage_reward_triggered"
        android:textColor="@color/parent_mock_green"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
