<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_report_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A1633"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#243B70" />

    <TextView
        android:id="@+id/tv_report_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingHorizontal="20dp"
        android:text="@string/quiz_report_dialog_title"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Step 1: reason list -->
    <LinearLayout
        android:id="@+id/layout_report_step_reasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_report_cancel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="20dp"
        android:backgroundTint="#1A2B52"
        android:text="취소"
        android:textAllCaps="false"
        android:textColor="#8A96AD"
        app:cornerRadius="16dp" />

    <!-- Step 2: detail -->
    <LinearLayout
        android:id="@+id/layout_report_step_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_report_selected_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C0C8D8"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_report_detail"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_situation_card"
            android:gravity="top|start"
            android:hint="@string/quiz_report_detail_hint"
            android:padding="14dp"
            android:textColor="@color/white"
            android:textColorHint="#8A96AD"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_report_back"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="#1A2B52"
                android:text="이전"
                android:textAllCaps="false"
                android:textColor="#8A96AD"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_report_submit"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_weight="2"
                android:backgroundTint="#00FFB2"
                android:text="@string/quiz_report_submit"
                android:textAllCaps="false"
                android:textColor="#0A1633"
                android:textStyle="bold"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_report_cancel_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:text="취소"
            android:textColor="#8A96AD"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_report_submit_without_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:text="@string/quiz_report_without_detail"
            android:textColor="#8A96AD"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

