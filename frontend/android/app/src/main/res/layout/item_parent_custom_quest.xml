<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="#F9FAFB"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_custom_quest_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/parent_mock_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="AI 없이 숙제 30분 하기" />

        <TextView
            android:id="@+id/tv_custom_quest_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_parent_privacy_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/parent_mock_indigo"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="진행 중" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_custom_quest_reward"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/parent_mock_text_secondary"
        android:textSize="13sp"
        tools:text="보상: 아이스크림 사줄게" />

    <TextView
        android:id="@+id/tv_custom_quest_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/parent_mock_text_muted"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="타이머를 켜고 혼자 해보기"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_custom_quest_expires"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/parent_mock_text_muted"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="2026.05.25 18:00까지"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_custom_quest_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:text="@string/parent_custom_quest_confirm"
            android:textColor="@color/parent_mock_green"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/btn_custom_quest_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:text="@string/parent_custom_quest_cancel"
            android:textColor="#DC2626"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
