<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundColor="#F9FAFB"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/parent_mock_border"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_quest_title"
            style="@style/Widget.AImong.ParentDialogEditText.SingleLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/parent_custom_quest_title_hint"
            android:inputType="textCapSentences"
            android:maxLength="80" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:boxBackgroundColor="#F9FAFB"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/parent_mock_border"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_quest_desc"
            style="@style/Widget.AImong.ParentDialogEditText.MultiLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/parent_custom_quest_desc_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="200" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:boxBackgroundColor="#F9FAFB"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/parent_mock_border"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_quest_reward"
            style="@style/Widget.AImong.ParentDialogEditText.SingleLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/parent_custom_quest_reward_hint"
            android:inputType="textCapSentences"
            android:maxLength="100" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/parent_custom_quest_expires_label"
        android:textColor="@color/parent_mock_text_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_expires_preset_today"
            style="@style/Widget.AImong.ParentDialogPresetChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/parent_custom_quest_expires_preset_today" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_expires_preset_week"
            style="@style/Widget.AImong.ParentDialogPresetChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/parent_custom_quest_expires_preset_week" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_quest_expires_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_parent_dialog_field"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:minHeight="52dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_study_color"
            app:tint="@color/parent_mock_blue" />

        <TextView
            android:id="@+id/tv_quest_expires_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textAlignment="center"
            android:textColor="@color/parent_mock_text_primary"
            android:textSize="15sp"
            tools:text="2026.05.26 18:00" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/parent_mock_text_muted" />
    </LinearLayout>
</LinearLayout>
