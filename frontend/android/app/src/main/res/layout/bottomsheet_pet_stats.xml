<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="28dp">

    <FrameLayout
        android:layout_width="@dimen/pet_sprite_stats_sheet"
        android:layout_height="@dimen/pet_sprite_stats_sheet">

        <ImageView
            android:id="@+id/iv_pet_sprite"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_pet_emoji"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="58sp"
            tools:text="✨" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_pet_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#1B2B4A"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="별이" />

    <TextView
        android:id="@+id/tv_pet_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#059669"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Lv.3" />

    <ProgressBar
        android:id="@+id/progress_pet_xp"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="16dp"
        android:max="100"
        android:progressTint="#A855F7"
        tools:progress="60" />

    <TextView
        android:id="@+id/tv_pet_xp_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#64748B"
        android:textSize="13sp"
        tools:text="120 / 200 XP" />
</LinearLayout>
