<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="#F9FAFB"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_stat_icon_blue"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_star_filled"
        app:tint="@color/parent_mock_blue" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_recent_mission_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/parent_dashboard_recent_mission_title"
            android:textColor="@color/parent_mock_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_recent_mission_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/parent_dashboard_recent_mission_time"
            android:textColor="@color/parent_mock_text_hint"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_recent_mission_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/parent_dashboard_recent_mission_score"
        android:textColor="@color/parent_mock_blue"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
