<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_gacha_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quiz_bg">

    <LinearLayout
        android:id="@+id/header_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gacha_header"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="112dp"
            android:paddingTop="8dp">

            <LinearLayout
                android:id="@+id/layout_tickets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gacha_ticket_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chip_ticket"
                        app:tint="@color/quiz_text_primary" />

                <TextView
                    android:id="@+id/tv_ticket_normal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/quiz_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="5" />
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_equipped_pet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_tickets">

                <View
                    android:id="@+id/view_equipped_glow"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_gacha_equipped_glow"
                    app:layout_constraintBottom_toBottomOf="@id/card_equipped_showcase"
                    app:layout_constraintEnd_toEndOf="@id/card_equipped_showcase"
                    app:layout_constraintStart_toStartOf="@id/card_equipped_showcase"
                    app:layout_constraintTop_toTopOf="@id/card_equipped_showcase" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_equipped_showcase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#F0FDF9"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/quiz_mint"
                    app:strokeWidth="2dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="14dp">

                        <FrameLayout
                            android:id="@+id/layout_equipped_sprite"
                            android:layout_width="@dimen/pet_sprite_gacha_header"
                            android:layout_height="@dimen/pet_sprite_gacha_header"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/iv_equipped_sprite"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:scaleType="fitCenter"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_equipped_emoji"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:textSize="64sp"
                                tools:text="⭐" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_equipped_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_gacha_equipped_badge"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="@string/gacha_equipped_now"
                            android:textColor="@color/quiz_mint_dark"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_equipped_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/quiz_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/card_equipped_showcase"
                    tools:text="반짝이" />

                <TextView
                    android:id="@+id/tv_equipped_stage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_gacha_level_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/quiz_on_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_equipped_name"
                    tools:text="성장"
                    tools:visibility="visible" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tv_equip_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gacha_equip_slot_empty"
                android:textColor="@color/quiz_text_secondary"
                android:textSize="13sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/layout_equipped_pet"
                app:layout_constraintEnd_toEndOf="@id/layout_equipped_pet"
                app:layout_constraintStart_toStartOf="@id/layout_equipped_pet"
                app:layout_constraintTop_toTopOf="@id/layout_equipped_pet"
                tools:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_equip_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/pet_equip_required_for_xp"
            android:textColor="@color/quiz_mint_dark"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/encyclopedia_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/quiz_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_container">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/gacha_encyclopedia_title"
            android:textColor="@color/quiz_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_encyclopedia_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/quiz_text_secondary"
            android:textSize="13sp"
            tools:text="5 / 22" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_pets"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_draw_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/encyclopedia_header"
        tools:itemCount="22"
        tools:listitem="@layout/item_gacha_pet_card" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_draw_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/quiz_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/layout_gacha_level_strip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/btn_pull"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_gacha_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_gacha_level_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/quiz_on_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Lv.3" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="6dp">

                <ProgressBar
                    android:id="@+id/pb_gacha_level_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="100"
                    android:progressDrawable="@drawable/bg_gacha_fragment_progress"
                    tools:progress="40" />

                <TextView
                    android:id="@+id/tv_gacha_level_progress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/quiz_on_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="5/50" />
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pull"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_gacha_pull_enabled"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/gacha_pull"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@color/quiz_on_accent"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_sparkles"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="22dp"
            app:iconTint="@color/quiz_on_accent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_gacha_level_strip" />

        <ImageButton
            android:id="@+id/btn_probabilities"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="-6dp"
            android:background="@drawable/bg_gacha_ticket_chip"
            android:contentDescription="@string/gacha_probabilities"
            android:elevation="6dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_info_outline"
            app:layout_constraintStart_toStartOf="@id/btn_pull"
            app:layout_constraintTop_toTopOf="@id/btn_pull"
            app:tint="@color/quiz_mint_dark" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ProgressBar
        android:id="@+id/pb_gacha"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
